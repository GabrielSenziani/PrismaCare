# JWT settings
JWT_SECRET=your_jwt_secret_key_here
JWT_ALG=HS256
GOOGLE_WEB_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
ACCESS_TTL_MIN=15
REFRESH_TTL_DAYS=14

# CORS allowlist (comma-separated)
CORS_ALLOW_ORIGINS=http://localhost:3000,http://localhost:8081,http://127.0.0.1:8081

# Endpoint manual de varredura
# Em produção, mantenha como false
ENABLE_MANUAL_MONITOR_ENDPOINT=false

# Scheduler automático de doses atrasadas
# Em testes automatizados, pode ser útil desabilitar
DISABLE_SCHEDULER=false

# Monitor de atraso de doses
# Tolerância para considerar uma confirmação atrasada
MONITOR_TOLERANCE_MINUTES=5
# Intervalo entre varreduras automáticas do scheduler
MONITOR_SCAN_INTERVAL_MINUTES=5

# Push remoto via Expo
# Requer app nativo (development build ou produção); não funciona no Expo Go.
EXPO_PUSH_ENABLED=false
EXPO_PUSH_API_URL=https://exp.host/--/api/v2/push/send
# Opcional para documentação do app; hoje o frontend já lê o projectId do app/EAS config.
EXPO_PROJECT_ID=

# WhatsApp provider: simulation | evolution
# Desenvolvimento local sem Evolution: simulation
# Ambiente integrado / VPS com Evolution: evolution
WHATSAPP_PROVIDER=simulation

# Evolution API
# Use 127.0.0.1 apenas se o backend acessar a Evolution na mesma máquina/container.
# Se a Evolution estiver em outra VPS/host, informe o domínio ou IP real.
EVOLUTION_API_URL=http://127.0.0.1:8080
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE_NAME=prismacare

# Endpoint manual de teste de WhatsApp
ENABLE_WHATSAPP_TEST_ENDPOINT=false

# Login lockout
LOGIN_LOCKOUT_THRESHOLD=5
LOGIN_LOCKOUT_MINUTES=15
LOGIN_LOCKOUT_MAX_MINUTES=60

# Rate limits per minute
RATE_LIMIT_LOGIN_PER_MIN=10
RATE_LIMIT_REFRESH_PER_MIN=20
RATE_LIMIT_API_PER_MIN=120
RATE_LIMIT_PHONE_SEND_PER_MIN=3
RATE_LIMIT_PHONE_VERIFY_PER_MIN=10

# Banco de dados (deixe vazio para usar o padrão local)
# DATABASE_PATH=/app/data/prismacare.db

# Frontend — URL base da API (prefixo EXPO_PUBLIC_ é obrigatório)
# Desenvolvimento: http://localhost:8000 ou http://10.0.2.2:8000 (Android)
# Produção: https://seudominio.com
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
